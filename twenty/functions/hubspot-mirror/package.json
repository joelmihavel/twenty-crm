{
  "name": "hubspot-mirror",
  "version": "1.0.0",
  "description": "Cloud Function to sync HubSpot data to Twenty CRM hourly",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "",
    "start": "npx functions-framework --target=hubspotMirror --source=dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^7.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
